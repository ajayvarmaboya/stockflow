# StockFlow Environment Configuration Example
# Copy this file to .env and adjust credentials as needed. Never commit .env into source control!

SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockflow
DB_USERNAME=stockflow_app
DB_PASSWORD=replace_with_secure_password_in_production
SERVER_PORT=8080
JWT_SECRET=replace_with_min_256_bit_secure_secret_key_in_production_environments_2026
APP_OUTBOX_POLL_INTERVAL_MS=5000
